{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "optcg-scanner": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "ort-wasm-simd-threaded.mjs",
                "input": "node_modules/onnxruntime-web/dist",
                "output": "assets/onnxruntime"
              },
              {
                "glob": "ort-wasm-simd-threaded.wasm",
                "input": "node_modules/onnxruntime-web/dist",
                "output": "assets/onnxruntime"
              },
              {
                "glob": "ort-wasm-simd-threaded.jsep.mjs",
                "input": "node_modules/onnxruntime-web/dist",
                "output": "assets/onnxruntime"
              },
              {
                "glob": "ort-wasm-simd-threaded.jsep.wasm",
                "input": "node_modules/onnxruntime-web/dist",
                "output": "assets/onnxruntime"
              }
            ],
            "styles": [
              "src/styles.css",
              "src/app/app.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "48kB",
                  "maximumError": "52kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "optcg-scanner:build:production"
            },
            "development": {
              "buildTarget": "optcg-scanner:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
